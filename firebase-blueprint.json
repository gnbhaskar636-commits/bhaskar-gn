{
  "entities": {
    "Video": {
      "title": "Video",
      "description": "A video uploaded by the admin.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "The title of the video." },
        "description": { "type": "string", "description": "A brief description of the video." },
        "videoUrl": { "type": "string", "format": "uri", "description": "The URL of the video file." },
        "thumbnailUrl": { "type": "string", "format": "uri", "description": "The URL of the video thumbnail." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the video was uploaded." },
        "authorUid": { "type": "string", "description": "The UID of the admin who uploaded it." }
      },
      "required": ["title", "videoUrl", "createdAt", "authorUid"]
    },
    "YouTubeLink": {
      "title": "YouTubeLink",
      "description": "A link to a YouTube video.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "The title of the YouTube video." },
        "videoId": { "type": "string", "description": "The ID of the YouTube video." },
        "description": { "type": "string", "description": "A brief description of the video." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the link was added." }
      },
      "required": ["title", "videoId", "createdAt"]
    },
    "AIContent": {
      "title": "AIContent",
      "description": "AI-generated images and information.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "The title of the content." },
        "description": { "type": "string", "description": "Information about the AI concept or image." },
        "imageUrl": { "type": "string", "format": "uri", "description": "The URL of the AI-generated image." },
        "category": { "type": "string", "enum": ["AI Art", "AI Tools", "AI Knowledge"], "description": "The category of the content." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the content was added." }
      },
      "required": ["title", "imageUrl", "category", "createdAt"]
    },
    "User": {
      "title": "User",
      "description": "User profile information.",
      "type": "object",
      "properties": {
        "displayName": { "type": "string", "description": "The user's display name." },
        "email": { "type": "string", "format": "email", "description": "The user's email address." },
        "photoURL": { "type": "string", "format": "uri", "description": "The user's profile photo URL." },
        "role": { "type": "string", "enum": ["admin", "user"], "description": "The user's role." }
      },
      "required": ["displayName", "email", "role"]
    },
    "Post": {
      "title": "Post",
      "description": "A community post or automated news item.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "The title of the news post (optional for regular posts)." },
        "content": { "type": "string", "description": "The text content of the post." },
        "category": { "type": "string", "description": "The category of the news (e.g., Research, Product)." },
        "tags": { "type": "array", "items": { "type": "string" }, "description": "Relevant tags for the news." },
        "readTime": { "type": "string", "description": "Estimated read time." },
        "imageUrl": { "type": "string", "format": "uri", "description": "AI-generated image for the news." },
        "authorName": { "type": "string", "description": "The name of the author." },
        "authorUid": { "type": "string", "description": "The UID of the author." },
        "authorEmail": { "type": "string", "description": "The email of the author." },
        "authorPhoto": { "type": "string", "format": "uri", "description": "The photo URL of the author." },
        "isAutomated": { "type": "boolean", "description": "Whether the post was generated by AI." },
        "type": { "type": "string", "enum": ["news", "post"], "description": "The type of post." },
        "likes": { "type": "number", "description": "Number of likes." },
        "commentsCount": { "type": "number", "description": "Number of comments." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the post was created." }
      },
      "required": ["content", "authorName", "authorUid", "createdAt"]
    },
    "Generation": {
      "title": "Generation",
      "description": "An AI-generated asset (image, video, audio).",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["image", "video", "audio"], "description": "The type of generation." },
        "url": { "type": "string", "format": "uri", "description": "The URL of the generated asset." },
        "prompt": { "type": "string", "description": "The prompt used for generation." },
        "userId": { "type": "string", "description": "The UID of the user who generated it." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When it was generated." }
      },
      "required": ["type", "url", "prompt", "userId", "createdAt"]
    }
  },
  "firestore": {
    "/videos/{videoId}": {
      "schema": "Video",
      "description": "Collection of uploaded videos."
    },
    "/youtubeLinks/{linkId}": {
      "schema": "YouTubeLink",
      "description": "Collection of YouTube video links."
    },
    "/aiContent/{contentId}": {
      "schema": "AIContent",
      "description": "Collection of AI-generated content."
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of user profiles."
    },
    "/posts/{postId}": {
      "schema": "Post",
      "description": "Collection of community posts and AI news."
    },
    "/generations/{generationId}": {
      "schema": "Generation",
      "description": "Collection of AI-generated assets."
    }
  }
}
